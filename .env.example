# Copy to .env and adjust. Every setting is optional.

# Limits
MAX_UPLOAD_MB=15
MAX_MEGAPIXELS=40
IMAGES_PER_MINUTE=120
BG_PER_MINUTE=30

# Background removal (needs rembg). Models: u2netp (fast, 4.5 MB), u2net (176 MB, more
# accurate), isnet-general-use, birefnet-general, ... - see rembg's README.
BG_REMOVAL=true
BG_MODEL=u2netp
BG_CONCURRENCY=2
PRELOAD_MODEL=true

# Set to true behind a reverse proxy (Render, Fly.io, nginx) so rate limits see real client IPs.
TRUST_PROXY=false
